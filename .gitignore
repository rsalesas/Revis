# Xcode
build/
DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# XcodeGen generates these from project.yml
Revis.xcodeproj/
Revis/Info.plist

# Swift Package Manager
.build/
.swiftpm/

# Code coverage artifacts
*.profraw
*.profdata

# macOS
.DS_Store

# Agent worktrees
#
# These live INSIDE the working tree, and each one is a full copy of the repository — so
# without this rule a `git add -A` from the project root commits the repo into itself.
# Narrow on purpose: `.claude/` itself stays available for anything worth tracking.
.claude/worktrees/

# Secrets
*.env
