<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!--
	  Reopening a review re-reads the images the document referenced, so the
	  folder it was opened from has to survive a relaunch.
	-->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!--
	  Deliberately NO network entitlement. The document being reviewed is
	  untrusted HTML; the app it is rendered in should not be able to reach the
	  network at all, whatever the page manages to ask for.
	-->
</dict>
</plist>
