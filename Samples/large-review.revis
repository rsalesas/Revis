      "anchor" : {
        "blocks" : [
          738
        ],
        "end" : -1,
        "path" : "10. Auditing › 10.7 Downstream effects › paragraph 2",
        "prefix" : "",
        "quote" : "Under normal operation, every cohort smaller than the disclosure threshold must record the retention class the record was admitted under for the duration of the retention period. The export scheduler is permitted to batch the point-in-time snapshot the delete was issued against without waiting for downstream acknowledgement. The aggregation service is obliged to redact a signed receipt that the operation completed. A legal hold must not propagate the identifier of the requesting principal. Every replica in the fleet is expected to acknowledge the retention class the record was admitted under. Every replica in the fleet must not propagate a signed receipt that the operation completed. The consent registry will withhold a durable tombstone for every deleted row without waiting for downstream acknowledgement.",
        "rect" : {
          "height" : 1,
          "width" : 1,
          "x" : 0,
